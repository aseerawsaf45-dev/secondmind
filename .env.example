# ==============================================================================
# SecondMind Environment Variables Template
# Copy this file to `.env.local` and replace the placeholder values with your real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication (Required)
# ------------------------------------------------------------------------------
# Get these from: https://dashboard.clerk.com/ -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# Route navigation paths for auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Clerk Webhooks (Dashboard -> Webhooks -> Add Endpoint -> Signing Secret)
# Used for auto-provisioning database branches on user creation
CLERK_WEBHOOK_SECRET=whsec_placeholder_secret_here

# ------------------------------------------------------------------------------
# 2. Neon Serverless Postgres Database (Required)
# ------------------------------------------------------------------------------
# ROOT branch connection string (Dashboard -> Project -> Connection details)
DATABASE_URL=postgresql://your_db_owner:your_password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require

# Neon Management API (Settings -> API Keys)
# Used to provision dedicated branches per user programmatically
NEON_API_KEY=napi_placeholder_neon_api_key_here

# Neon Project ID (Found in console.neon.tech/app/projects/<project-id>)
NEON_PROJECT_ID=placeholder-project-id

# ------------------------------------------------------------------------------
# 3. Application Domain & URLs (Optional / Production)
# ------------------------------------------------------------------------------
# Base URL for OAuth callbacks and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Supabase (Optional / Migration fallback)
# ------------------------------------------------------------------------------
# Only needed if using Supabase storage or auth features.
# Enforce Row Level Security (RLS) on all tables when using the Anon key.
# NEVER expose SERVICE_ROLE_KEY to the frontend.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
